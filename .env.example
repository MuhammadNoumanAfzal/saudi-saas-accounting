# PostgreSQL Database Connection URL
# For Railway production with Supabase, prefer Supabase pooler/IPv4 compatible URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saudi_accounting

# Public app URLs
FRONTEND_URL=http://localhost:5176
PORT=5000
NODE_ENV=development

# Clerk Authentication - Server Side Keys
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Clerk Authentication - Frontend Side Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# API hardening
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Optional production distributed rate limiting
# Use Upstash Redis REST credentials on Railway production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REDIS_PREFIX=khanbas:rate-limit

# Optional monitoring/logging providers
# Sentry requires adding @sentry/node before SDK capture is enabled in code.
SENTRY_DSN=
# Axiom/Datadog are usually connected through Railway log drains or agents.
AXIOM_TOKEN=
AXIOM_DATASET=
DATADOG_API_KEY=

# Real ZATCA production/sandbox integration
ZATCA_ENV=sandbox
ZATCA_CSR_BASE64=
ZATCA_PRIVATE_KEY_PEM=
ZATCA_COMPLIANCE_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal/compliance