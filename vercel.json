{
  "buildCommand": "pnpm --filter @workspace/saudi-accounting run build",
  "outputDirectory": "artifacts/saudi-accounting/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
